# Contoh konfigurasi lingkungan. SALIN ke .env.local lalu sesuaikan.
#   cp .env.example .env.local
#
# .env.local DIABAIKAN oleh git dan tidak boleh pernah di-commit — isinya bisa
# memuat token. File ini yang masuk ke repositori.

# --- Database ---------------------------------------------------------------
# LibSQL / Turso. Untuk pengembangan lokal, path file lokal sudah cukup:
#   TURSO_DATABASE_URL=file:./data/uji.db
# Untuk produksi, pakai URL Turso + token:
#   TURSO_DATABASE_URL=libsql://<nama-database>.turso.io
#   TURSO_AUTH_TOKEN=<token-dari-dashboard-turso>
TURSO_DATABASE_URL=file:./data/uji.db
TURSO_AUTH_TOKEN=

# --- Asal aplikasi ----------------------------------------------------------
# WAJIB sama persis dengan origin tempat aplikasi diakses. wajibOrigin()
# membandingkan EKSAK: nilai yang berawalan sama tetap DITOLAK, dan origin kosong
# juga ditolak.
#
# Produksi:
#   APP_ORIGIN=https://arsaba.vercel.app
APP_ORIGIN=https://arsaba.vercel.app

# --- Pengembangan lokal (opsional) -----------------------------------------
# Origin dev HANYA dibaca saat NODE_ENV=development, yaitu saat memakai `npm run dev`.
# Variabel ini DIABAIKAN di produksi — membuka `npm start` lokal tetap memakai
# APP_ORIGIN di atas dan pemeriksaan Origin tidak melemah sama sekali.
#
# PENTING: `npm run dev` (development) BUKAN `npm run build && npm start` (production).
# Kalau memakai mode produksi, set APP_ORIGIN=http://localhost:3000 — bukan
# APP_ORIGIN_DEV.
APP_ORIGIN_DEV=http://localhost:3000

# --- Seed -------------------------------------------------------------------
# Password untuk dua akun awal (superadmin dan admin) yang dibuat oleh
# `npx tsx scripts/seed.ts`. WAJIB diganti lewat /admin/ubah-password setelah
# seed. Jangan pernah memakai nilai ini di produksi.
SEED_PASSWORD=ganti-sebelum-dipakai
